{
  "name": "collection-search-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p . && pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "synth": "pnpm --filter infra synth",
    "web": "pnpm --filter web dev",
    "fetch-sample": "tsx scripts/fetch-sample.ts",
    "os": "tsx scripts/os.ts",
    "cdk:deploy": "pnpm --filter infra exec cdk deploy",
    "ingest": "tsx scripts/ingest.ts",
    "check:analysis": "tsx scripts/check-analysis.ts",
    "generate:api": "openapi-typescript openapi.yaml -o functions/lib/api/types.gen.ts",
    "check:bundles": "pnpm synth && tsx scripts/check-bundles.ts",
    "status": "tsx scripts/status.ts",
    "teardown": "tsx scripts/teardown.ts",
    "kb:sync": "tsx scripts/kb-sync.ts",
    "kb:retrieve": "tsx scripts/kb-retrieve.ts",
    "guardrail:test": "tsx scripts/guardrail-test.ts",
    "ask": "tsx scripts/ask.ts",
    "call": "tsx scripts/call.ts",
    "user:create": "tsx scripts/user-create.ts",
    "eval": "tsx scripts/eval.ts",
    "eval:search": "tsx scripts/eval-search.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-api-gateway": "3.1165.0",
    "@aws-sdk/client-bedrock": "3.1165.0",
    "@aws-sdk/client-bedrock-agent": "3.1166.0",
    "@aws-sdk/client-bedrock-agent-runtime": "3.1166.0",
    "@aws-sdk/client-bedrock-runtime": "3.1166.0",
    "@aws-sdk/client-cloudformation": "3.1165.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1165.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1166.0",
    "@aws-sdk/client-cost-explorer": "3.1165.0",
    "@aws-sdk/client-ec2": "3.1165.0",
    "@aws-sdk/client-lambda": "3.1165.0",
    "@aws-sdk/client-opensearch": "3.1165.0",
    "@aws-sdk/client-opensearchserverless": "3.1165.0",
    "@aws-sdk/client-resource-groups-tagging-api": "3.1165.0",
    "@aws-sdk/client-secrets-manager": "3.1165.0",
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
