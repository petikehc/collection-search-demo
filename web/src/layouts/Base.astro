---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/atkinson-hyperlegible-next';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { APP_NAME, CULTURAL_NOTICE, NOTICE_COOKIE } from '../lib/notice.js';

/** Shown in search results and share cards when a page doesn't give its own. */
const DEFAULT_DESCRIPTION =
  "Search the National Museum of Australia's public collection, or ask a question and get an answer drawn only from its records, with citations. An independent learning project.";

interface Props {
  title: string;
  /** One or two sentences about this page, for search results and share cards. */
  description?: string;
  /** Keep this page out of search engines (results, sign-in, personal pages). */
  noindex?: boolean;
  /** `narrow` for single-column pages; results use the full width. */
  width?: 'wide' | 'narrow';
}
const { title, description = DEFAULT_DESCRIPTION, noindex = false, width = 'wide' } = Astro.props;
const fullTitle = `${title} · ${APP_NAME}`;
const site = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname + Astro.url.search, site).href;
// One share image for every page. Not the Museum's images: platforms copy and cache shared
// images, and the Museum's terms allow its images only hotlinked, alongside the record.
const shareImage = new URL('/og.png', site).href;
const { user } = Astro.locals;
const here = Astro.url.pathname + Astro.url.search;
const showNotice = Astro.cookies.get(NOTICE_COOKIE)?.value !== 'dismissed';
const container = width === 'narrow' ? 'container narrow' : 'container';
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f3a40" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={pageUrl} />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={APP_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Collection Search: search the National Museum of Australia's collection, or just ask."
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    {
      showNotice && (
        <aside class="notice" aria-label="Cultural notice">
          <div class={container}>
            <p>{CULTURAL_NOTICE}</p>
            <form method="post" action="/notice">
              <input type="hidden" name="returnTo" value={here} />
              <button type="submit">Dismiss</button>
            </form>
          </div>
        </aside>
      )
    }

    <div class="band">
      <header class:list={[container, 'site-header']}>
        <a class="brand" href="/">Collection Search</a>
        <div class="account">
          <a href="/bookmarks" rel="nofollow">
            <Icon name="bookmark" />
            <span class="label">Bookmarks</span>
          </a>
          {
            user ? (
              <form method="post" action="/auth/logout">
                <span class="who">{user.email ?? 'Signed in'}</span>
                <button type="submit">Sign out</button>
              </form>
            ) : (
              <a href={`/auth/login?returnTo=${encodeURIComponent(here)}`} rel="nofollow">
                Sign in
              </a>
            )
          }
        </div>
      </header>
      <slot name="band" />
    </div>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class={container}>
        <p>{CULTURAL_NOTICE}</p>
        <p>
          {APP_NAME} was developed using the National Museum of Australia's{' '}
          <a href="https://github.com/NationalMuseumAustralia/Collection-API">Collection API</a>.
          Collection metadata © National Museum of Australia,{' '}
          <a href="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</a>. Images are
          shown from the Museum's website under the rights stated with each one.
        </p>
        <p>
          An independent, non-commercial learning project. Not affiliated with or endorsed by the
          National Museum of Australia.
        </p>
      </div>
    </footer>
  </body>
</html>
