---
import Icon from '../../components/Icon.astro';
import ObjectDetail from '../../components/ObjectDetail.astro';
import Base from '../../layouts/Base.astro';
import { listBookmarks } from '../../lib/api.js';
import { getObject } from '../../lib/museum.js';
import { safeReturnTo } from '../../lib/session.js';

const id = Astro.params.id ?? '';
if (!/^[0-9]{1,12}$/.test(id)) return new Response('Not found', { status: 404 });
const { user } = Astro.locals;
// From the results on a phone: a way back to the same list (a local path only).
const back = Astro.url.searchParams.get('back');
const backTo = back ? safeReturnTo(back) : undefined;

// The record and (if signed in) whether it's bookmarked, fetched in parallel.
const [objectResult, bookmarksResult] = await Promise.allSettled([
  getObject(id),
  user ? listBookmarks(user.accessToken) : Promise.resolve([]),
]);
const object = objectResult.status === 'fulfilled' ? objectResult.value : null;
const unavailable = objectResult.status === 'rejected';
if (unavailable) console.error('museum lookup failed', objectResult.reason);
if (!object && !unavailable) Astro.response.status = 404;
if (unavailable) Astro.response.status = 502;

// If bookmarks can't be read, offer "Bookmark": adding again is harmless.
// For search results and share cards: what the object is, in the Museum's words.
const description = object
  ? (
      [object.physicalDescription, object.contentDescription, object.description].find(Boolean) ??
      `${object.title}, from the National Museum of Australia's collection.`
    )
      .replace(/\s+/g, ' ')
      .slice(0, 200)
  : undefined;
const bookmarked =
  bookmarksResult.status === 'fulfilled' && bookmarksResult.value.some((b) => b.objectId === id);
---

<Base
  title={object?.title ?? 'Object not found'}
  description={description}
  width="narrow"
>
  <div class="container narrow page">
    {
      backTo && backTo !== '/' && (
        <a class="back-link" href={backTo}>
          <Icon name="back" />
          Back to results
        </a>
      )
    }
    {
      unavailable && (
        <p class="message error" role="alert">
          The Museum's Collection API isn't responding. Please try again shortly.
        </p>
      )
    }
    {
      !object && !unavailable && (
        <div class="paper">
          <h1>Object not found</h1>
          <p>
            The Museum may have withdrawn this record. <a href="/">Search the collection</a>.
          </p>
        </div>
      )
    }
    {
      object && (
        <div class="paper">
          <ObjectDetail
            object={object}
            bookmarked={bookmarked}
            returnTo={Astro.url.pathname + Astro.url.search}
          />
        </div>
      )
    }
  </div>
</Base>
