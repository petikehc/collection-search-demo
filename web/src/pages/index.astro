---
import Base from '../layouts/Base.astro';
import { ApiError, type SearchParams, type SearchResponse, search } from '../lib/api.js';

const q = Astro.url.searchParams;
const int = (name: string) => {
  const value = Number.parseInt(q.get(name) ?? '', 10);
  return Number.isFinite(value) ? value : undefined;
};
const params: SearchParams = {
  q: q.get('q') ?? undefined,
  type: q.get('type') ?? undefined,
  place: q.get('place') ?? undefined,
  yearFrom: int('yearFrom'),
  yearTo: int('yearTo'),
  page: int('page'),
  size: 20,
};

let result: SearchResponse | undefined;
let error: string | undefined;
try {
  result = await search(params);
} catch (err) {
  error =
    err instanceof ApiError && err.status === 400
      ? err.message
      : 'Search is unavailable right now. Please try again shortly.';
  if (!(err instanceof ApiError && err.status === 400)) console.error('search failed', err);
}

/** This page's URL with some parameters changed (undefined removes one); always back to page 1. */
const withParams = (changes: Record<string, string | number | undefined>) => {
  const next = new URLSearchParams(Astro.url.search);
  next.delete('page');
  for (const [key, value] of Object.entries(changes)) {
    if (value === undefined) next.delete(key);
    else next.set(key, String(value));
  }
  return `/?${next}`;
};
const pageLink = (page: number) => {
  const next = new URLSearchParams(Astro.url.search);
  next.set('page', String(page));
  return `/?${next}`;
};
const page = result?.page ?? 1;
const lastPage = result ? Math.min(100, Math.ceil(result.total / result.size)) : 1;
---

<Base title={params.q ? `“${params.q}”` : 'Search'}>
  <h1>Search the collection</h1>
  <form class="search-form" method="get" action="/" role="search">
    <label class="visually-hidden" for="q">Search</label>
    <input id="q" type="search" name="q" value={params.q ?? ''} placeholder="e.g. spearthrower, telegraph, quilt" maxlength="200" />
    {params.type && <input type="hidden" name="type" value={params.type} />}
    {params.place && <input type="hidden" name="place" value={params.place} />}
    <input type="number" name="yearFrom" value={params.yearFrom ?? ''} placeholder="From year" min="0" max="2100" aria-label="From year" />
    <input type="number" name="yearTo" value={params.yearTo ?? ''} placeholder="To year" min="0" max="2100" aria-label="To year" />
    <button type="submit">Search</button>
  </form>

  {
    (params.type || params.place || params.yearFrom || params.yearTo) && (
      <p class="filters">
        <span class="muted">Filters:</span>
        {params.type && <a href={withParams({ type: undefined })}>Type: {params.type} ✕</a>}
        {params.place && <a href={withParams({ place: undefined })}>Place: {params.place} ✕</a>}
        {(params.yearFrom || params.yearTo) && (
          <a href={withParams({ yearFrom: undefined, yearTo: undefined })}>
            Years: {params.yearFrom ?? '…'}–{params.yearTo ?? '…'} ✕
          </a>
        )}
      </p>
    )
  }

  {error && <p class="error" role="alert">{error}</p>}

  {
    result && (
      <div class="search-layout">
        <aside class="facets" aria-label="Refine">
          <h2>Type</h2>
          <ul>
            {result.facets.types.map((f) => (
              <li>
                <a href={withParams({ type: f.value })}>{f.value}</a>
                <span class="muted">{f.count}</span>
              </li>
            ))}
          </ul>
          <h2>Place</h2>
          <ul>
            {result.facets.places.map((f) => (
              <li>
                <a href={withParams({ place: f.value })}>{f.value}</a>
                <span class="muted">{f.count}</span>
              </li>
            ))}
          </ul>
          {result.facets.decades.length > 0 && (
            <>
              <h2>Decade</h2>
              <p class="muted">{result.facets.datedCount} of these objects have a date.</p>
              <ul>
                {result.facets.decades.map((d) => (
                  <li>
                    <a href={withParams({ yearFrom: d.decade, yearTo: d.decade + 9 })}>{d.decade}s</a>
                    <span class="muted">{d.count}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
        </aside>

        <section aria-label="Results">
          <p class="muted">
            {result.total.toLocaleString('en-AU')} {result.total === 1 ? 'object' : 'objects'}
            {result.total >= 10000 && ' or more'}
          </p>
          <ol class="results">
            {result.results.map((r) => (
              <li class="result">
                {r.thumbnail ? (
                  <img src={r.thumbnail.url} alt="" loading="lazy" title={r.thumbnail.rightsTitle} />
                ) : (
                  <span class="no-image">No image</span>
                )}
                <div>
                  <h3>
                    <a href={`/object/${r.id}`}>{r.title}</a>
                  </h3>
                  <p class="muted">
                    {[r.types.join(', '), r.dateLabel, r.places[0]].filter(Boolean).join(' · ')}
                  </p>
                  {/* OpenSearch escapes the record text (encoder: html), then adds only <mark>. */}
                  {r.highlight && <p set:html={r.highlight} />}
                </div>
              </li>
            ))}
          </ol>
          {result.results.length === 0 && <p>No objects match. Try fewer words or remove a filter.</p>}
          <nav class="pager" aria-label="Pages">
            {page > 1 ? <a href={pageLink(page - 1)}>← Previous</a> : <span />}
            {page < lastPage && <a href={pageLink(page + 1)}>Next →</a>}
          </nav>
          <p class="muted">{result.attribution}</p>
        </section>
      </div>
    )
  }
</Base>
