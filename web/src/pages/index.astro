---
import FilterMenu from '../components/FilterMenu.astro';
import SearchBox from '../components/SearchBox.astro';
import Base from '../layouts/Base.astro';
import { getHomeData, type HomeData } from '../lib/home.js';
import { withFilter } from '../lib/search-url.js';

let data: HomeData | undefined;
try {
  data = await getHomeData();
} catch (err) {
  console.error('home data failed', err);
}
const filters = data
  ? [
      {
        label: 'Type',
        options: data.facets.types.map((f) => ({
          label: f.value,
          count: f.count,
          href: withFilter({}, { type: f.value }),
        })),
      },
      {
        label: 'Place',
        options: data.facets.places.map((f) => ({
          label: f.value,
          count: f.count,
          href: withFilter({}, { place: f.value }),
        })),
      },
      {
        label: 'Decade',
        options: data.facets.decades.map((d) => ({
          label: `${d.decade}s`,
          count: d.count,
          href: withFilter({}, { yearFrom: d.decade, yearTo: d.decade + 9 }),
        })),
      },
    ]
  : [];
const count = data ? data.total.toLocaleString('en-AU') : 'thousands of';
---

<Base title="Search the collection" width="narrow">
  <div slot="band" class="container narrow home-hero">
    <h1>Search {count} objects from the National Museum of Australia</h1>
    <SearchBox size="hero" />
    <div class="filter-row">
      {filters.map((f) => <FilterMenu label={f.label} options={f.options} />)}
      <a class="filter-link" href={withFilter({}, { hasImage: true })} rel="nofollow">
        With images only
      </a>
    </div>
    <p class="hint">
      Try <a href="/search?q=woomera" rel="nofollow">woomera</a>, or ask{' '}
      <a href="/search?q=What+did+people+use+to+start+fires%3F" rel="nofollow"
        >What did people use to start fires?</a
      >{' '}
      Questions are answered by an AI model from the Museum's records, so please don't include
      personal details.
    </p>
  </div>

  <div class="container narrow page">
    {
      !data && (
        <p class="message error" role="alert">
          Search is unavailable right now. Please try again shortly.
        </p>
      )
    }
    {
      data && data.featured.length > 0 && (
        <section class="featured" aria-labelledby="featured-heading">
          <h2 id="featured-heading">From the collection today</h2>
          <ul class="featured-grid">
            {data.featured.map((o) => (
              <li>
                <a href={`/object/${o.id}`}>
                  <img src={o.thumbnail?.url} alt="" loading="lazy" width="320" height="240" />
                  <span class="featured-title">{o.title}</span>
                  <span class="muted small">
                    {[o.types[0], o.dateLabel ?? o.places[0]].filter(Boolean).join(', ')}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>
