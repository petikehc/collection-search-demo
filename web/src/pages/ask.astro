---
import Base from '../layouts/Base.astro';
import { ApiError, type AskResponse, ask } from '../lib/api.js';

// The middleware only lets signed-in users reach this page.
const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login?returnTo=/ask');

let question = '';
let answer: AskResponse | undefined;
let error: string | undefined;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  question = String(form.get('question') ?? '').trim();
  if (question.length < 3 || question.length > 500) {
    error = 'Please ask a question of 3 to 500 characters.';
  } else {
    try {
      answer = await ask(user.accessToken, question);
    } catch (err) {
      if (err instanceof ApiError && err.status === 401) {
        return Astro.redirect('/auth/login?returnTo=/ask');
      }
      error =
        err instanceof ApiError && err.status === 429
          ? "You're asking faster than the limit allows. Wait a moment and try again."
          : 'Ask is unavailable right now. Please try again shortly.';
      console.error('ask failed', err);
    }
  }
}
---

<Base title="Ask">
  <h1>Ask the collection</h1>
  <p class="muted">
    Answers are written by an AI model using only the collection records it finds, with links to
    them. It can still be wrong: check the records it cites.
  </p>
  <form class="ask-form" method="post">
    <label for="question">Your question</label>
    <textarea id="question" name="question" rows="3" minlength="3" maxlength="500" required>{question}</textarea>
    <div><button type="submit">Ask</button></div>
  </form>

  {error && <p class="error" role="alert">{error}</p>}

  {
    answer && (
      <section aria-label="Answer">
        <p class="answer">{answer.answer}</p>
        {answer.guardrailAction === 'INTERVENED' && (
          <p class="muted">This question or answer was stopped by a safety check.</p>
        )}
        {answer.citations.length > 0 && (
          <>
            <h2>Based on these records</h2>
            <ul class="citations">
              {answer.citations.map((c) => (
                <li>
                  <a href={`/object/${c.objectId}`}>{c.title}</a> ·{' '}
                  <a href={c.sourceUrl} class="muted">on the Museum's website</a>
                </li>
              ))}
            </ul>
          </>
        )}
        <p class="muted">{answer.attribution}</p>
      </section>
    )
  }
</Base>
