---
import Base from '../layouts/Base.astro';
import { ApiError, addBookmark, type Bookmark, listBookmarks, removeBookmark } from '../lib/api.js';
import { safeReturnTo } from '../lib/session.js';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/auth/login?returnTo=/bookmarks');

// POST: add or remove, then redirect (so refreshing the page doesn't repeat it).
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const objectId = String(form.get('objectId') ?? '');
  try {
    if (form.get('action') === 'add') {
      await addBookmark(user.accessToken, objectId, String(form.get('title') ?? ''));
    } else if (form.get('action') === 'remove') {
      await removeBookmark(user.accessToken, objectId);
    }
  } catch (err) {
    if (err instanceof ApiError && err.status === 401) {
      return Astro.redirect('/auth/login?returnTo=/bookmarks');
    }
    console.error('bookmarks change failed', err);
    return new Response('Could not update your bookmarks. Go back and try again.', {
      status: 502,
    });
  }
  return Astro.redirect(safeReturnTo(String(form.get('returnTo') ?? '/bookmarks')), 303);
}

let bookmarks: Bookmark[] = [];
let error: string | undefined;
try {
  bookmarks = await listBookmarks(user.accessToken);
} catch (err) {
  console.error('bookmarks list failed', err);
  error = 'Your bookmarks are unavailable right now. Please try again shortly.';
}
---

<Base title="Bookmarks">
  <h1>Your bookmarks</h1>
  {error && <p class="error" role="alert">{error}</p>}
  {!error && bookmarks.length === 0 && (
    <p>No bookmarks yet. Open any object from <a href="/">search</a> and choose “Bookmark”.</p>
  )}
  <ul class="bookmarks">
    {
      bookmarks.map((f) => (
        <li>
          <span>
            <a href={`/object/${f.objectId}`}>{f.title}</a>{' '}
            <span class="muted">
              added {new Date(f.addedAt).toLocaleDateString('en-AU', { timeZone: 'Australia/Sydney' })}
            </span>
          </span>
          <form method="post" class="inline">
            <input type="hidden" name="action" value="remove" />
            <input type="hidden" name="objectId" value={f.objectId} />
            <button type="submit" class="secondary" aria-label={`Remove ${f.title}`}>Remove</button>
          </form>
        </li>
      ))
    }
  </ul>
</Base>
